# Local development defaults. Do not store real secrets in this file.
DJANGO_SETTINGS_MODULE=brokerdex.settings.local
DJANGO_READ_DOT_ENV_FILE=True
DJANGO_SECRET_KEY=replace-with-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DATABASE_URL=postgresql://brokerdex_user@localhost:5432/brokerdex_db
TEST_DATABASE_URL=postgresql://brokerdex_user@localhost:5432/brokerdex_db
REDIS_URL=redis://localhost:6379/0
# REDIS_CACHE_URL=redis://localhost:6379/1
DEPOSIT_WEBHOOK_SECRET=replace-with-a-random-hmac-secret

# Production security controls use secure defaults.
DJANGO_CSRF_TRUSTED_ORIGINS=https://brokerdex.example.com
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
DJANGO_TRUST_X_FORWARDED_PROTO=False
